# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
OPENAQ_API_KEY=
# Optional: grounded assistant. The app falls back to a sourced data summary.
OPENAI_API_KEY=

# Optional: Responses API model (defaults to gpt-4.1-mini)
OPENAI_MODEL=gpt-4.1-mini
# Optional: keyed server reverse geocoding for arbitrary globe pins
BIGDATACLOUD_API_KEY=

# Shared server request quotas (Upstash Redis REST; never NEXT_PUBLIC_)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Marketplace may inject KV_REST_API_URL and KV_REST_API_TOKEN instead.
# Their paired values are supported automatically when no UPSTASH pair is set.

# Optional reported live station AQI. Obtain your own token; server-only.
# Review https://aqicn.org/api/ usage terms and attribution requirements.
WAQI_API_TOKEN=

# Optional nearest-city current US AQI. Free Community plan; server-only.
# Get your own key at https://dashboard.iqair.com/
IQAIR_API_KEY=
